Options -Indexes
php_flag display_errors on
php_value error_reporting -1

DirectoryIndex public/index.html

RewriteEngine On

# Archivos físicos existen - servir directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# API → Slim
RewriteRule ^api/(.*)$ api/public/index.php [L,QSA]

# Archivos estáticos en public/
RewriteCond %{REQUEST_URI} \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot|json|xml|txt|pdf)$ [NC]
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
RewriteRule ^(.*)$ public/$1 [L]

# TODO lo demás → SvelteKit
RewriteRule ^ public/index.html [L]