# Deshabilitar directory listing
Options -Indexes
php_flag display_errors on
php_value error_reporting -1
# Specifically handle the root directory
DirectoryIndex public/index.html

RewriteEngine On

# Serve existing files and directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# API requests → Slim app
RewriteRule ^api/(.*)$ api/public/index.php [L,QSA]

# If the request is for a file that exists in public/, serve it
RewriteCond %{DOCUMENT_ROOT}/public/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/public/$1 -d
RewriteRule ^(.*)$ public/$1 [L]

# All other non-API requests → SvelteKit index.html
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ public/index.html [L]