# Deshabilitar directory listing
Options -Indexes


RewriteEngine On

# TODO lo demás → SvelteKit (incluyendo raíz)
RewriteCond %{REQUEST_URI} !^/api/
RewriteRule ^(.*)$ public/index.html [L]

# API → Slim
RewriteRule ^api/(.*)$ api/public/index.php [L,QSA]

# Archivos estáticos que existen (css, js, imágenes) - servirlos directamente
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]